# AI Configuration
DEFAULT_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Options: cloudflare | ollama | mock
AI_PROVIDER=mock

# Cloudflare Credentials (for production Workers AI & D1 API access if calling Cloudflare REST API directly)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
DATABASE_ID=d0cb6d6f-b338-42d4-8eb0-19a757548112

# Security Secrets
AUTH_SECRET=bodhai_secure_auth_secret_token_change_in_production_32_chars
ADMIN_EMAIL=admin@bodhai.com

# Usage & Rate Limits
AUTHENTICATED_DAILY_LIMIT=30
GUEST_DAILY_LIMIT=5
MAX_PROMPT_CHARS=10000

# Local Ollama URL (Only required if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
